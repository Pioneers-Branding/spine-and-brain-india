RewriteEngine On

# Canonical: www to non-www
RewriteCond %{HTTP_HOST} ^www\.spineandbrainindia\.com$ [NC]
RewriteRule ^(.*)$ https://spineandbrainindia.com/$1 [L,R=301]

# 1. External redirect: /index.php to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/ [NC]
RewriteRule ^index\.php$ / [R=301,L]

# 2. External redirect: /page.php to /page (direct browser requests with .php)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php [NC]
RewriteRule ^([^.]+)\.php$ /$1 [R=301,L]

# 3. Internally add .php extension for clean URLs (serves /page from page.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)$ $1.php [L]

# 4. Old about-us redirects
RewriteRule ^about-us/docto(.*)$ /about [R=301,L,NC]
RewriteRule ^about-us/?$ /about [R=301,L,NC]
RewriteRule ^about/doctors-profile/?$ / [R=301,L,NC]
RewriteRule ^about/$ /about [R=301,L,NC]

# 5. Redirects for old/deprecated standalone pages to homepage
RewriteRule ^best-treatment-cervical-spondylosis-in-India(\.php)?/?$ / [R=301,L,NC]
RewriteRule ^brain-haemorrhage/?$ / [R=301,L,NC]
RewriteRule ^brain-tumor-type-cancer/?$ / [R=301,L,NC]
RewriteRule ^best-spine-surgeon-in-delhi/?$ / [R=301,L,NC]
RewriteRule ^portfolio/brain-tumor/?$ / [R=301,L,NC]
RewriteRule ^portfolio/disc-herniation/?$ / [R=301,L,NC]
RewriteRule ^services\.html$ / [R=301,L,NC]
RewriteRule ^course-detail\.html$ / [R=301,L,NC]
RewriteRule ^contact-us/?$ /contact [R=301,L,NC]
RewriteRule ^spondylosis/?$ / [R=301,L,NC]
RewriteRule ^slipped-disc-surgery/?$ / [R=301,L,NC]
RewriteRule ^make-an-appointment/?$ /contact [R=301,L,NC]
RewriteRule ^ind/?$ / [R=301,L,NC]
RewriteRule ^new-service/?$ / [R=301,L,NC]
RewriteRule ^new-location-page/?$ / [R=301,L,NC]

# 6. Specific exact redirects to treatment pages (Ensures regional city pages are NOT hijacked)
RewriteRule ^blood-clot-brain-treatment-in-India-1/?$ /blood-clot-brain-treatment-in-India [R=301,L,NC]
RewriteRule ^blood-clot-brain-treatment-in-India-old/?$ /blood-clot-brain-treatment-in-India [R=301,L,NC]
