RewriteEngine on

RewriteCond %{HTTP_HOST} ^www.spineandbrainindia.com$ [NC]
RewriteRule ^(.*)$ https://spineandbrainindia.com/$1 [L,R=301]

# To externally redirect /dir/foo.php to /dir/foo
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.php\ HTTP/ [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Internally add .php extension for clean URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Old about-us redirects (using RewriteRule to avoid mod_alias conflicts)
RewriteRule ^about-us/docto(.*)$ /about [R=301,L]
RewriteRule ^about-us/?$ /about [R=301,L]
RewriteRule ^about/doctors-profile/?$ / [R=301,L]
RewriteRule ^about/$ /about [R=301,L]

# Redirects for old/deprecated standalone pages to homepage
RedirectMatch 301 ^/best-treatment-cervical-spondylosis-in-India(\.php)?/?$ /
RedirectMatch 301 ^/brain-haemorrhage/?$ /
RedirectMatch 301 ^/brain-tumor-type-cancer/?$ /
RedirectMatch 301 ^/best-spine-surgeon-in-delhi/?$ /
RedirectMatch 301 ^/portfolio/brain-tumor/?$ /
RedirectMatch 301 ^/portfolio/disc-herniation/?$ /
RedirectMatch 301 ^/services\.html$ /
RedirectMatch 301 ^/course-detail\.html$ /
RedirectMatch 301 ^/contact-us/?$ /contact
RedirectMatch 301 ^/spondylosis/?$ /
RedirectMatch 301 ^/slipped-disc-surgery/?$ /
RedirectMatch 301 ^/make-an-appointment/?$ /contact
RedirectMatch 301 ^/ind/?$ /
RedirectMatch 301 ^/new-service/?$ /
RedirectMatch 301 ^/new-location-page/?$ /

# Specific exact redirects to treatment pages (Using RedirectMatch so regional city pages are NOT hijacked)
RedirectMatch 301 ^/blood-clot-brain-treatment-in-India-1/?$ /blood-clot-brain-treatment-in-India
RedirectMatch 301 ^/blood-clot-brain-treatment-in-India-old/?$ /blood-clot-brain-treatment-in-India
